# Copy to docker-compose.override.yml for local development.
# The renamed file is gitignored.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   make build && make up
#
# This override makes a local run possible with NO SOPS setup and NO age key:
# secrets are read in plaintext from secrets/secrets.dev.yaml, Caddy serves plain
# HTTP on :80, and the session cookie drops the __Host- prefix and Secure flag so
# a browser will actually accept it over http://localhost.
#
# Every relaxation below requires FINANCEHUB_ENV=development, which both
# entrypoint.sh and app/config.py check independently. None of these values may
# ever appear in docker-compose.yml.

services:
  app:
    # !override replaces the base file's volume list instead of merging into it.
    # Without this, docker-compose.yml's bind mounts for /etc/financehub/age-key.txt
    # and ./secrets/secrets.enc.yaml are inherited, and because neither file exists
    # on a dev machine Docker would silently create DIRECTORIES at those paths.
    # Requires Compose v2.24+.
    volumes: !override
      - db_data:/data
      - ml_models:/models
      # Plaintext dev secrets. Production mounts the SOPS-encrypted file and an
      # age key instead; neither is needed here.
      - ./secrets/secrets.dev.yaml:/secrets/secrets.dev.yaml:ro
    ports:
      - "127.0.0.1:8000:8000"   # expose the app directly for dev tools
    environment:
      - PYTHONDONTWRITEBYTECODE=1
      - PYTHONUNBUFFERED=1
      # Gate for every relaxation below. Without this they are all inert.
      - FINANCEHUB_ENV=development
      # Skip SOPS entirely and load the plaintext dev secrets mounted above.
      - FINANCEHUB_DEV_SECRETS=/secrets/secrets.dev.yaml
      # Local dev is plain http://localhost, where browsers reject both the
      # __Host- cookie prefix and the Secure attribute. Without this you cannot
      # log in at all.
      - FINANCEHUB_INSECURE_COOKIES=1
      # WebAuthn RP ID / origin for localhost. Passkeys need a secure context, so
      # use the TOTP login locally; these just keep the endpoints coherent.
      - FINANCEHUB_RP_ID=localhost
      - FINANCEHUB_ORIGIN=http://localhost

  caddy:
    volumes:
      - ./infra/caddy/Caddyfile.dev:/etc/caddy/Caddyfile:ro   # http-only local config
      - ./static:/srv/static:ro
      - caddy_data:/data
      - caddy_config:/config
