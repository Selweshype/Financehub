# Copy to docker-compose.override.yml for local development.
# This file is gitignored when renamed.
#
# Usage: cp docker-compose.override.yml.example docker-compose.override.yml
#
# Overrides for local dev:
#   - age key read from a local path instead of /etc/financehub/
#   - app port exposed to localhost for debugging
#   - Caddy replaced with http-only local proxy

services:
  app:
    volumes:
      - db_data:/data
      - ml_models:/models
      - ./secrets/age-key-dev.txt:/secrets/age-key.txt:ro   # local dev key
      - ./secrets/secrets.enc.yaml:/secrets/secrets.enc.yaml:ro
    ports:
      - "127.0.0.1:8000:8000"   # expose locally for dev tools
    environment:
      - SOPS_AGE_KEY_FILE=/secrets/age-key.txt
      - PYTHONDONTWRITEBYTECODE=1
      - PYTHONUNBUFFERED=1
      - ENV=development
      # Marks this as a development deployment. Required before either of the
      # two relaxations below will take effect at all.
      - FINANCEHUB_ENV=development
      # Local dev is served over plain http://localhost, where browsers reject
      # both the __Host- cookie prefix and the Secure attribute — so without
      # this you cannot log in at all. NEVER set this in docker-compose.yml.
      - FINANCEHUB_INSECURE_COOKIES=1
      # WebAuthn RP ID / origin for localhost. Passkeys still require a secure
      # context, so use the TOTP path locally; these keep the endpoints sane.
      - FINANCEHUB_RP_ID=localhost
      - FINANCEHUB_ORIGIN=http://localhost
      # Uncomment to skip SOPS and load secrets/secrets.dev.yaml in plaintext.
      # Only honoured because FINANCEHUB_ENV=development is set above.
      # - FINANCEHUB_DEV_SECRETS=/app/secrets/secrets.dev.yaml

  caddy:
    volumes:
      - ./infra/caddy/Caddyfile.dev:/etc/caddy/Caddyfile:ro   # http-only local config
      - ./static:/srv/static:ro
      - caddy_data:/data
      - caddy_config:/config
